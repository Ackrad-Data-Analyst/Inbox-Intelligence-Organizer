# Local semantic classifier (recommended for mailbox privacy)
INBOX_AI_PROVIDER=ollama
INBOX_AI_URL=http://localhost:11434/api/chat
INBOX_AI_MODEL=llama3.2:3b

# Optional OpenAI-compatible classifier. Never commit the real key.
INBOX_AI_API_KEY=

# Microsoft delegated OAuth app registration
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT=common

